# URL usada pela API em desenvolvimento local (fora do Docker).
CRM_DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm

# Tenant atendido por esta implantação. O Gateway deve enviar este mesmo valor no header X-Tenant-Slug.
CRM_TENANT_SLUG=demo-textil

# Gere um valor aleatório longo para cada ambiente; nunca versione o valor real.
CRM_INTERNAL_HMAC_SECRET=replace-with-a-long-random-secret
CRM_INTERNAL_HMAC_TOLERANCE_SECONDS=300

